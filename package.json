{
  "name": "anysocket",
  "version": "1.0.0",
  "description": "A custom protocol over any transport: client/server agnostic, binary framed, with authenticated end-to-end encryption",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test --test-timeout=30000 \"tests/unit/*.test.js\" \"tests/core/*.test.js\" \"tests/wire/*.test.js\" \"tests/crypto/*.test.js\" \"tests/security/*.test.js\" \"tests/browser/*.test.js\" \"tests/interop/*.test.js\"",
    "test:unit": "node --test --test-timeout=10000 \"tests/unit/*.test.js\"",
    "test:core": "node --test --test-timeout=15000 \"tests/core/*.test.js\"",
    "test:wire": "node --test --test-timeout=15000 \"tests/wire/*.test.js\"",
    "test:crypto": "node --test --test-timeout=20000 \"tests/crypto/*.test.js\"",
    "test:security": "node --test --test-timeout=20000 \"tests/security/*.test.js\"",
    "test:interop": "node --test --test-timeout=30000 \"tests/interop/*.test.js\"",
    "test:fast": "node --test --test-timeout=20000 \"tests/unit/*.test.js\" \"tests/core/*.test.js\" \"tests/wire/*.test.js\"",
    "bench": "node benchmarks/run.js",
    "build": "webpack",
    "test:browser": "node --test --test-timeout=20000 \"tests/browser/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/lynxaegon/anysocket.git"
  },
  "keywords": [
    "anysocket",
    "e2ee",
    "network",
    "socket",
    "websocket",
    "ws",
    "wss",
    "tcp",
    "http",
    "https",
    "udp",
    "binary",
    "end-to-end",
    "encrypted",
    "json",
    "rpc",
    "proxy",
    "p2p"
  ],
  "author": "Andrei Vaduva",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lynxaegon/anysocket/issues"
  },
  "homepage": "https://github.com/lynxaegon/anysocket#readme",
  "dependencies": {
    "debug": "^4.3.2",
    "fastq": "^1.11.0",
    "ws": "^7.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.12.10",
    "@babel/plugin-proposal-class-properties": "^7.12.1",
    "babel-loader": "^8.2.2",
    "null-loader": "^4.0.1",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1",
    "anysocket-legacy": "npm:anysocket@0.4.32"
  },
  "files": [
    "src/",
    "dist/",
    "README.md",
    "MIGRATING-1.0.md",
    "LICENSE"
  ]
}
